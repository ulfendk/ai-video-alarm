# Copy to .env and fill in real values. .env is gitignored — never commit
# real secrets.

# Frigate's HTTP API base URL (already-running instance).
FRIGATE_URL=http://frigate.local:5000

# Existing Mosquitto broker (shared with Frigate/HA).
MQTT_HOST=mosquitto.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Anthropic API key, for Tier-2 cloud vision escalation.
ANTHROPIC_API_KEY=

# Archive quota, in GB. Default sits in the middle of the requested
# 20-50GB range.
ARCHIVE_QUOTA_GB=30

# Tier-2 (Claude vision) escalation cap, calls/day. Sized for a minimal
# (~$5-10/mo) budget — tune once real call costs are observed.
CLOUD_AI_DAILY_CALL_CAP=20

# Base URL the VPN/reverse-proxy exposes, used when building media links
# for HA mobile-app push notifications.
PUBLIC_MEDIA_BASE_URL=

# Topic base your HA instance forwards entity state changes to (HA's MQTT
# statestream integration default is "homeassistant"; change if you use a
# different bridge). Used for door/window contact-sensor correlation —
# see docs/clarifying-questions.md.
HA_STATESTREAM_BASE_TOPIC=homeassistant

# --- Deployment (docker-compose.yml / Portainer) ---
# See docs/deployment/portainer.md for the full guide.

# Which GHCR image tag to pull. "latest" tracks the default branch;
# pin to a short-sha or version tag for a stable rollout.
IMAGE_TAG=latest

# GHCR namespace the image is published under (only change this if you've
# forked the repo and publish under your own GitHub account/org).
GHCR_OWNER=ulfendk

# Host port the alarm-core API/media server is published on.
API_PORT=8090

# Real host paths for config/archive/db. Leave unset to use the
# repo-relative defaults (fine for local dev); on a Portainer host, point
# these at real, persistent directories, e.g.:
#   CONFIG_HOST_PATH=/srv/ai-video-alarm/config/alarm-core.yaml
#   ARCHIVE_HOST_PATH=/srv/ai-video-alarm/archive
#   DB_HOST_PATH=/srv/ai-video-alarm/db
CONFIG_HOST_PATH=
ARCHIVE_HOST_PATH=
DB_HOST_PATH=
